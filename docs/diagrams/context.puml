@startuml
!include skin.iuml
left to right direction
actor "Khách tham quan\n(ẩn danh)" as V
actor "Biên tập viên /\nQuản trị viên" as A
rectangle "Hệ thống thuyết minh đa ngôn ngữ theo vị trí" as S {
  component "Mobile App\n(React Native)" as M
  component "Web User\n(React.js)" as WU
  component "Web Admin\n(React.js)" as WA
  component "Backend API\n+ Socket.IO" as API
  database "SQL Server" as DB
}
cloud "Vệ tinh GPS\n(dịch vụ định vị thiết bị)" as GPS
rectangle "Biển QR + số điểm\ntại các phòng" as QR
V --> M : nghe thuyết minh
V --> WU : quét QR, nghe
A --> WA : quản lý nội dung
GPS --> M : vị trí
QR --> M : quét mã
M --> API
WU --> API
WA --> API
API --> DB
@enduml
