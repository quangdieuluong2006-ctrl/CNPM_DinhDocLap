@startuml
!include skin.iuml
rectangle "Nhánh feature/*\nfix/* · docs/*" as F
rectangle "Pull Request\nvào develop" as PR
rectangle "CI (mỗi Pull Request)\nci-api: typecheck · lint · test\n  + SQL Server · build\nci-web · ci-admin: … · build\nci-mobile: … · expo export\nci-docs: liên kết · sơ đồ\ne2e: Playwright" as CI
rectangle "Review\n≥ 1 Approve\n(người khác tác giả)" as RV
rectangle "develop" as DV
rectangle "PR develop → main\n(bản phát hành)" as PM
rectangle "main" as MN
rectangle "release.yml (CD)" as RL
artifact "Web User + Web Admin\n(bản build tĩnh .zip)" as WB
artifact "API Docker image\n(GitHub Container Registry)" as IMG
artifact "APK Android\n(EAS Build)" as APK
rectangle "GitHub Release vX.Y" as GR
F --> PR
PR --> CI
CI --> RV
RV --> DV
DV --> PM
PM --> MN
MN --> RL : tag v*
RL --> WB
RL --> IMG
RL --> APK
WB --> GR
IMG --> GR
APK --> GR
@enduml
