{
  "expo": {
    "name": "Dinh Độc Lập",
    "slug": "dinhdoclap",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "vn.edu.cnpm.dinhdoclap"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "vn.edu.cnpm.dinhdoclap"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Ứng dụng dùng vị trí để tự động phát thuyết minh khi bạn đến gần một điểm trong Dinh Độc Lập. Vị trí không được gửi lên máy chủ."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Ứng dụng dùng camera để quét mã QR tại các phòng trưng bày.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false
        }
      ],
      "expo-secure-store",
      "expo-localization"
    ],
    "scheme": "dinhdoclap",
    "experiments": {
      "typedRoutes": false
    }
  }
}
