# Sao chép thành .env rồi sửa giá trị. KHÔNG commit file .env.
PORT=3000
LOG_LEVEL=info

# SQL Server (trùng với docker-compose.yml ở thư mục gốc)
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=DinhDocLapDB
DB_USER=sa
DB_PASSWORD=Doi_Mat_Khau_Nay_123
# Docker/dev dùng chứng chỉ tự ký nên cần tin cậy chứng chỉ máy chủ
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=true

# Mật khẩu chung cho tài khoản mẫu khi chạy db:seed (chỉ dùng ở môi trường dev)
SEED_PASSWORD=Demo@12345

# Khóa ký access token: chuỗi ngẫu nhiên ≥ 32 ký tự. Tạo bằng:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=doi-chuoi-nay-bang-chuoi-ngau-nhien-dai-it-nhat-32-ky-tu
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=7
COOKIE_SECURE=false
LOGIN_RATE_LIMIT_MAX=10
# Chu kỳ (giây) đóng các phiên presence mất nhịp tim quá 60 giây
PRESENCE_CLEANUP_INTERVAL_SEC=30
# Mã QR "Mời tham gia" trên Web Admin trỏ tới Web User: http://<IP Wi-Fi của máy>:WEB_USER_PORT/register
WEB_USER_PORT=5173
# Nếu Web User đã đưa lên Internet (ví dụ Vercel) thì đặt địa chỉ đó, QR sẽ dùng địa chỉ này
# WEB_USER_PUBLIC_URL=https://cnpm-pied.vercel.app

CORS_ORIGINS=http://localhost:5173,http://localhost:5174
