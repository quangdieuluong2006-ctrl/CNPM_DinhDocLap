# Sao chép thành .env.local nếu cần đổi. Mặc định để trống: Vite chuyển tiếp /api, /socket.io, /media
# tới API ở http://localhost:3000 (xem vite.config.ts), nên không cần cấu hình CORS khi dev.
VITE_API_BASE_URL=
# Địa chỉ API mà máy chủ dev của Vite chuyển tiếp tới
API_PROXY_TARGET=http://localhost:3000
